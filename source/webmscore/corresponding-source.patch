+// SPDX-License-Identifier: GPL-3.0-only
+// Copyright 2026 Luckolite
+// Exact time conversion for the standalone GPL engraving renderer.
+#ifndef MU_ENGRAVING_MUSICXMLTIMEGRID_H
+#define MU_ENGRAVING_MUSICXMLTIMEGRID_H
+#include <cstdint>
+#include <limits>
+#include <numeric>
+#include <stdexcept>
+namespace mu::engraving::musicxml {
+inline void boundedFraction(int64_t numerator, int64_t denominator)
+{
+    if (numerator < std::numeric_limits<int>::min() || numerator > std::numeric_limits<int>::max()
+        || denominator <= 0 || denominator > std::numeric_limits<int>::max()) {
+        throw std::runtime_error("MusicXML fraction is outside the native range");
+    }
+}
+class TimeGrid {
+    int m_divisions;
+public:
+    explicit TimeGrid(int initial = 1) : m_divisions(initial)
+    {
+        if (initial <= 0) {
+            throw std::runtime_error("MusicXML divisions must be positive");
+        }
+    }
+    void observe(int64_t numerator, int64_t denominator)
+    {
+        boundedFraction(numerator, denominator);
+        const int64_t magnitude = numerator < 0 ? -numerator : numerator;
+        const int64_t required = denominator / std::gcd(4 * magnitude, denominator);
+        const int64_t quotient = m_divisions / std::gcd(int64_t(m_divisions), required);
+        if (quotient > std::numeric_limits<int>::max() / required) {
+            throw std::runtime_error("MusicXML exact divisions grid is too large");
+        }
+        m_divisions = int(quotient * required);
+    }
+    int divisions() const { return m_divisions; }
+};
+inline int exactUnits(int64_t numerator, int64_t denominator, int divisions)
+{
+    boundedFraction(numerator, denominator);
+    if (divisions <= 0) {
