+// Direction timing is independent of the existence and order of notes in voices.
+// Emit hairpins in chronological order once per part/measure, preserving exact
+// endpoint clocks and numbering even when all four voices sustain through them.
+static void hairpinsInMeasure(ExportMusicXml* exp, track_idx_t firstTrack, int staves, const Measure* measure)
+{
+    struct Endpoint {
+        const Hairpin* hairpin;
+        Fraction tick;
+        bool start;
+        int order;
+    };
+    std::vector<Endpoint> endpoints;
+    for (const auto& item : exp->score()->spanner()) {
+        Spanner* span = item.second;
+        if (!span->isHairpin() || !exp->canWrite(span) || span->track() < firstTrack
+            || span->track() >= firstTrack + staves * VOICES) {
+            continue;
+        }
+        const Hairpin* hp = toHairpin(span);
+        const bool zero = span->tick() == span->tick2();
+        if (span->tick() >= measure->tick() && span->tick() < measure->endTick()) {
+            endpoints.push_back({hp, span->tick(), true, zero ? 1 : 3});
+        }
+        if ((span->tick2() > measure->tick() && span->tick2() <= measure->endTick())
+            || (zero && span->tick2() == measure->tick())) {
+            endpoints.push_back({hp, span->tick2(), false, zero ? 2 : 0});
+        }
+    }
+    std::stable_sort(endpoints.begin(), endpoints.end(), [](const Endpoint& a, const Endpoint& b) {
+        return a.tick != b.tick ? a.tick < b.tick : a.order < b.order;
+    });
+    const Fraction previousTick = exp->tick();
+    for (const Endpoint& endpoint : endpoints) {
+        exp->moveToTick(endpoint.tick);
+        const staff_idx_t staff = staves > 1 ? endpoint.hairpin->staffIdx() - track2staff(firstTrack) + 1 : 0;
+        exp->hairpin(endpoint.hairpin, staff, endpoint.start ? endpoint.tick : Fraction(-1, 1));
+    }
+    exp->moveToTick(previousTick);
+}
