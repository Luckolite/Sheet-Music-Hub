+static double delayedTurnX(const Chord* chord, double x)
+{
+    if (chord->isGrace() || !chord->segment() || !chord->measure()) return x;
+    Segment* next = chord->segment()->nextCR(chord->track());
+    double endX = chord->measure()->width() - chord->segment()->x() - chord->x();
+    if (next && next->measure() == chord->measure())
+        endX = next->x() - chord->segment()->x() - chord->x();
+    return x + std::max(0.0, endX - x) * 0.5;
+}
