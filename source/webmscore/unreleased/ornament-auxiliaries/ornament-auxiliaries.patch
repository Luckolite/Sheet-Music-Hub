+static SymId ornamentAuxiliarySymbol(const QString& value)
+{
+    if (value == "flat") return SymId::accidentalFlat;
+    if (value == "natural") return SymId::accidentalNatural;
+    if (value == "sharp") return SymId::accidentalSharp;
+    if (value == "flat-flat") return SymId::accidentalDoubleFlat;
+    if (value == "double-sharp" || value == "sharp-sharp") return SymId::accidentalDoubleSharp;
+    return SymId::noSym;
+}
+
+static void applyOrnamentAuxiliaries(const Notation& notation, Articulation* articulation)
+{
+    if (!articulation->isOrnament()) return;
+    articulation->setOrnamentAuxiliary(ornamentAuxiliarySymbol(notation.attribute("ornament-aux-above")), true);
+    articulation->setOrnamentAuxiliary(ornamentAuxiliarySymbol(notation.attribute("ornament-aux-below")), false);
+}
