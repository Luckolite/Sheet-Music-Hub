+//---------------------------------------------------------
+//   ornament auxiliaries
+//---------------------------------------------------------
+
+bool Articulation::readOrnamentAuxiliary(XmlReader& e)
+{
+    const AsciiStringView tag(e.name());
+    if (tag != "ornamentAuxiliaryAbove" && tag != "ornamentAuxiliaryBelow") return false;
+    bool above = tag == "ornamentAuxiliaryAbove";
+    setOrnamentAuxiliary(SymNames::symIdByName(e.readAsciiText()), above);
+    return true;
+}
+
+void Articulation::writeOrnamentAuxiliaries(XmlWriter& xml) const
+{
+    if (isOrnament()) {
+        if (_ornamentAuxAbove != SymId::noSym)
+            xml.tag("ornamentAuxiliaryAbove", SymNames::nameForSymId(_ornamentAuxAbove));
+        if (_ornamentAuxBelow != SymId::noSym)
+            xml.tag("ornamentAuxiliaryBelow", SymNames::nameForSymId(_ornamentAuxBelow));
+    }
+}
+
+void Articulation::setOrnamentAuxiliary(SymId symbol, bool above)
+{
+    switch (symbol) {
+    case SymId::noSym:
+    case SymId::accidentalFlat:
+    case SymId::accidentalNatural:
+    case SymId::accidentalSharp:
+    case SymId::accidentalDoubleFlat:
+    case SymId::accidentalDoubleSharp:
+        break;
+    default:
+        symbol = SymId::noSym;
+        break;
+    }
+    (above ? _ornamentAuxAbove : _ornamentAuxBelow) = symbol;
 }
 
