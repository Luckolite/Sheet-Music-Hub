+// Copyright 2026 Luckolite
+// SPDX-License-Identifier: GPL-3.0-only
+#ifndef MU_ENGRAVING_ORNAMENT_AUX_LAYOUT_H
+#define MU_ENGRAVING_ORNAMENT_AUX_LAYOUT_H
+namespace mu { namespace engraving { namespace ornament_aux {
+constexpr double scale = 0.65;
+struct Box { double x, y, width, height; };
+struct Placement { double x, y; Box bounds; };
+// Font bearings stay in the calculation; neither glyph is centered by its advance.
+inline Placement place(Box ornament, Box accidental, bool above, double gap)
+{
+    double x = ornament.x + ornament.width * 0.5 - accidental.x - accidental.width * 0.5;
+    double y = above ? ornament.y - gap - accidental.y - accidental.height
+                     : ornament.y + ornament.height + gap - accidental.y;
+    return { x, y, { accidental.x + x, accidental.y + y, accidental.width, accidental.height } };
+}
+}}}
+#endif
