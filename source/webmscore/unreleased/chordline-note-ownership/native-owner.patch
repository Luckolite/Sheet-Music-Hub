+
+void ChordLine::setNote(Note* note)
+{
+    _note = note;
+    _notePitch = note ? note->pitch() : -1;
+}
+
+Note* ChordLine::note() const
+{
+    if (!explicitParent()) {
+        return nullptr;
+    }
+    // Check membership before dereferencing a possibly removed or foreign note.
+    if (_note) {
+        Note* live = nullptr;
+        for (Note* candidate : chord()->notes()) {
+            if (candidate == _note) {
+                live = candidate;
+                break;
+            }
+        }
+        if (!live) {
+            return nullptr;
+        }
+        for (Note* candidate : chord()->notes()) {
+            if (candidate != live && candidate->pitch() == live->pitch()) {
+                return nullptr;
+            }
+        }
+        return live;
+    }
+    Note* owner = nullptr;
+    for (Note* candidate : chord()->notes()) {
+        if (candidate->pitch() == _notePitch) {
+            if (owner) {
+                return nullptr; // A pitch key cannot disambiguate unison heads.
+            }
+            owner = candidate;
+        }
+    }
+    return owner;
 }
 
