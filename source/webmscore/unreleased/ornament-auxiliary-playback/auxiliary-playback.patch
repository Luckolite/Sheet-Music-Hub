 // sustainp, true means the last note of the body is sustained to fill remaining time slice
 //---------------------------------------------------------
 
+static bool ornamentAuxiliaryAlteration(SymId symbol, int& alteration)
+{
+    switch (symbol) {
+    case SymId::accidentalDoubleFlat: alteration = -2; return true;
+    case SymId::accidentalFlat: alteration = -1; return true;
+    case SymId::accidentalNatural: alteration = 0; return true;
+    case SymId::accidentalSharp: alteration = 1; return true;
+    case SymId::accidentalDoubleSharp: alteration = 2; return true;
+    default: return false;
+    }
+}
+
+static int ornamentPitchSteps(const Note* note, int steps, SymId upper, SymId lower)
+{
+    // Only the explicit adjacent auxiliary is changed; principal/key/context stay local.
+    SymId symbol = steps == 1 ? upper : steps == -1 ? lower : SymId::noSym;
+    int alteration = 0;
+    if (!ornamentAuxiliaryAlteration(symbol, alteration))
+        return chromaticPitchSteps(note, note, steps);
+    const Chord* chord = note->chord();
+    const Staff* staff = note->score()->staff(chord->vStaffIdx());
+    int natural = line2pitch(note->line() - steps, staff->clef(chord->tick()), Key::C);
+    return natural + alteration - note->epitch();
+}
